{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review node artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "message"],
        "properties": {
          "severity": { "enum": ["blocker", "high", "medium", "low", "nit"] },
          "message": { "type": "string", "minLength": 1 },
          "file": { "type": "string" }
        }
      }
    }
  }
}
